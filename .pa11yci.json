{
  "defaults": {
    "standard": "WCAG2AA",
    "runners": ["axe", "htmlcs"],
    "runInChrome": true,
    "wait": 2000,
    "hideElements": "[data-scope='dialog'], [aria-hidden='true']",
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-dev-shm-usage"
      ]
    }
  }
}
